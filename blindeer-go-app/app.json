{
  "expo": {
    "name": "Blindeer & Go Planning",
    "slug": "blindeer-go-planning",
    "scheme": "blindeergo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F14",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nl.blindeergo.planning",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Om foto's van een auto of behandeling bij een afspraak of als profielfoto toe te voegen.",
        "NSCameraUsageDescription": "Om foto's van een auto of behandeling bij een afspraak te maken."
      }
    },
    "android": {
      "package": "nl.blindeergo.planning",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "lang": "nl",
      "name": "Blindeer & Go Planning",
      "shortName": "B&G Planning",
      "backgroundColor": "#0B0F14",
      "favicon": "./public/icons/favicon-64.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Om foto's van een auto of behandeling bij een afspraak of als profielfoto toe te voegen.",
          "cameraPermission": "Om foto's van een auto of behandeling bij een afspraak te maken."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
