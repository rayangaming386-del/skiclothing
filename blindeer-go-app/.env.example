# Kopieer naar .env (wordt niet in git opgeslagen) en vul in vanuit Supabase → Project Settings → API.
# Deze twee waarden zijn bedoeld voor de app en mogen in de app staan (publiek/anon key, beschermd door RLS).
# Zet NOOIT de service_role/secret key in de app of in dit bestand.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable-of-anon-key>
